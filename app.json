{
  "expo": {
    "name": "snappylit-v2",
    "slug": "snappylit-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/snappylit-logo-v3.png",
    "scheme": "snappylit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/snappylit-logo-v3.png",
      "bundleIdentifier": "com.txrroy.snappylitv2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/snappylit-logo-v3.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.txrroy.snappylitv2"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/snappylit-logo-v3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/snappylit-logo-v3.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "cc292c83-62b3-4222-8dce-3d447548a45c"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "txrroy"
  }
}
